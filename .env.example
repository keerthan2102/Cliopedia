# Cliopedia environment variables — TEMPLATE ONLY.
#
# Copy to .env and fill in local values:   cp .env.example .env
#
# .env is git-ignored. This file is committed, so it documents variable NAMES
# and safe development defaults. It must never contain a real secret.
#
# Every variable below is read in cliopedia/config.py and nowhere else.


# --- LLM backend -------------------------------------------------------------
# Ollama (local) and Groq (deployed) both speak the OpenAI-compatible
# chat-completions API, so there is exactly one client in the codebase and the
# backend is chosen here. Switching to production changes these three lines and
# nothing else — no code branch, no fork.
#
#   development                        deployment
#   http://localhost:11434/v1          https://api.groq.com/openai/v1

LLM_BASE_URL=http://localhost:11434/v1

# Which model on that endpoint. Locally this must be a model you have pulled:
#   ollama pull llama3.1:8b
LLM_MODEL=llama3.1:8b

# THE ONLY REAL SECRET IN THIS PROJECT.
# Ollama ignores this value entirely but the OpenAI client requires something
# non-empty, so "ollama" is a placeholder, not a credential.
# In production this is a real Groq key and it lives in Streamlit Cloud's
# secrets manager. Never in code, never in this file, never in a commit.
LLM_API_KEY=ollama


# --- Index -------------------------------------------------------------------
# Where the persisted Chroma index lives. Committed to the repo, because the
# deployed app only ever reads a prebuilt index — it never ingests at startup.
CHROMA_DIR=data/chroma

# The embedding model turns text into a 384-number vector so passages can be
# compared by meaning rather than by keyword.
#
# THIS MUST MATCH BETWEEN INGEST AND QUERY. Vectors produced by different models
# are not comparable, so changing this value requires a full index rebuild
# (python -m cliopedia.ingest). A stale index read with a new model does not
# error — it returns confidently wrong citations, which is worse.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# How many chunks to retrieve per question and hand to the model.
# Too few starves the answer; too many dilutes the prompt with noise.
#
# 6 is measured, not guessed. Against eval/questions.txt the hit rate is
# 86.7% at k=4, 93.3% at k=5, and 100% at k=6 — and still 100% at k=7, 8
# and 16. Six is the smallest k that finds every known-correct page.
# Re-run `python -m cliopedia.evaluate --sweep` after any corpus change.
RETRIEVAL_K=6

# Reranking — off by default.
#
# Retrieves a wider pool of candidates with the embedding model, then re-scores
# every one against the question with a cross-encoder and keeps the best
# RETRIEVAL_K. The embedding model never sees the question and a passage
# together; a cross-encoder does, which is much more accurate and much too slow
# to run over all 9275 chunks. Hence two stages.
#
# Measured on the 31-question set: hit rate 93.5% -> 100%, MRR 0.699 -> 0.883.
# The largest retrieval gain recorded in this project. Costs about 450ms per
# query and downloads a second model (~80MB) the first time it runs. No new
# pip dependency: CrossEncoder ships inside sentence-transformers.
#
# Off by default for deployment reasons rather than quality ones. SPEC.md 2.2
# records that Streamlit Community Cloud's memory limits are unverified for
# even the first model. Turn it on locally freely; decide about the deployed
# app at P3, when the limits are actually tested.
RERANK=false

# Which cross-encoder, and how many candidates it re-scores. 20 measured
# identically to 30 and 50 (MRR 0.883 vs 0.882), so the cheapest depth wins —
# every extra candidate is another pass at query time.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_DEPTH=20
